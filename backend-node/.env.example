# Copy this file to backend-node/.env and fill in your GoDaddy values.
# Never commit the real .env file.

# --- GoDaddy MySQL (cPanel > MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=chaiorder
DB_PASSWORD=your_db_password
DB_NAME=chaiorder

# --- App ---
JWT_SECRET=put_a_long_random_string_here
CLIENT_ORIGIN=https://yourdomain.com
APP_TZ=Asia/Kolkata
DB_TZ=+05:30

# --- WEBSITE OWNER (you) ---
# Created automatically on first start. Sign in at https://yourdomain.com/platform
# to see every cafe, suspend/activate them and set plan + subscription end date.
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=choose_a_strong_password

# --- Optional (you can also change the first two from the owner panel > Settings) ---
# Let anyone create a cafe at /signup (true / false).
SIGNUP_OPEN=true
# New cafes wait for your approval before anything is created (true / false).
APPROVAL_REQUIRED=true
# Shown to a cafe when it is suspended or its subscription ended
SUPPORT_CONTACT=+91 90000 00000
